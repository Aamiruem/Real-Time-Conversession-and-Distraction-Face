# ===== Backend =====
APP_NAME=FocusLink AI
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite for local dev. For AWS RDS PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/focuslink
DATABASE_URL=sqlite:///./focuslink.db
# docker compose uses its own Postgres unless you point it at RDS:
# DATABASE_URL_OVERRIDE=postgresql+psycopg2://USER:PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/focuslink

# Public site URL (canonical links, sitemap, Open Graph) — used when building the Next.js frontend
SITE_URL=http://localhost:3000

# Easy sign-up: false = anyone can register and log in immediately (no codes, mobile optional).
# Defaults to true only when AWS_ENABLED=true (codes can actually be delivered).
# REQUIRE_VERIFICATION=false

# ===== Legacy Streamlit frontend (frontend/) =====
BACKEND_URL=http://127.0.0.1:8010
BACKEND_WS_URL=ws://127.0.0.1:8010

# ===== MCP server (AI assistants use FocusLink as tools) =====
# Local: python -m backend.mcp_server (stdio) — no key needed. Remote: set a long random key to enable POST /mcp
# MCP_API_KEY=
# Let the coach_speech_file tool read audio files from the server's disk (fine for local stdio use)
# MCP_ALLOW_FILES=true

# ===== AWS (optional - app works without it) =====
AWS_ENABLED=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=focuslink-ai-reports
# Use Amazon Comprehend for sentiment instead of local VADER
USE_COMPREHEND=false

# ===== One-time passwords (sign-up verification, OTP login, password reset) =====
# Email via Amazon SES — must be a verified identity (aws/setup_aws.sh does this)
SES_SENDER=no-reply@yourdomain.com
# SMS via Amazon SNS — sender ID shown on supporting networks (India needs DLT registration)
SNS_SENDER_ID=FOCUSAI
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
# true = show codes in the UI/log instead of sending (default while AWS_ENABLED=false). NEVER true in production.
# OTP_DEV_MODE=false
