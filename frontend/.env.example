# Where the FastAPI backend runs (the dev/preview server proxies /api/* to it)
BACKEND_URL=http://127.0.0.1:8010
# Public site URL used for canonical links, sitemap and Open Graph (baked in at build time).
# On Vercel it defaults to the project's production address; set it when you add your own domain.
VITE_SITE_URL=http://localhost:3000
# Google Search Console "HTML tag" ownership check: just the content="..." value, not the whole tag (optional)
GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement id, G-XXXXXXXXXX (optional). In GA, turn OFF "Page changes based on browser history
# events" under Enhanced measurement: the app reports pages itself, and that setting would count each one twice.
GA_MEASUREMENT_ID=
# WebSocket base for rooms chat + meetings. Empty = same origin (Nginx, and the dev/preview server forward /ws).
# Vercel with the services setup (vercel.json at the repo root) forwards /ws itself: leave it empty there.
# Frontend-only Vercel + API on Render: wss://presence-api.onrender.com
VITE_WS_URL=
