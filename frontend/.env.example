# Where the FastAPI backend runs (the dev/preview server proxies /api/* to it)
BACKEND_URL=http://127.0.0.1:8010
# Public site URL used for canonical links, sitemap and Open Graph (baked in at build time)
VITE_SITE_URL=http://localhost:3000
# WebSocket base for rooms chat + meetings. Empty = same origin (Nginx, and the dev/preview server forward /ws).
# On Vercel (no WebSocket proxy) set it to the backend: wss://presence-api.onrender.com
VITE_WS_URL=
