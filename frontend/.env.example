# Where the FastAPI backend runs (server-side proxy target for /api/*)
BACKEND_URL=http://127.0.0.1:8010
# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WebSocket base for chat rooms. Empty = same origin (production behind Nginx). Dev default: ws://<host>:8010
NEXT_PUBLIC_WS_URL=
