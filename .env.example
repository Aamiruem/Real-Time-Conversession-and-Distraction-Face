# ===== Backend =====
APP_NAME=FocusLink AI
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# SQLite for local dev. For AWS RDS PostgreSQL use:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@your-rds-endpoint.rds.amazonaws.com:5432/focuslink
DATABASE_URL=sqlite:///./focuslink.db

# ===== Frontend =====
BACKEND_URL=http://localhost:8000
BACKEND_WS_URL=ws://localhost:8000

# ===== AWS (optional - app works without it) =====
AWS_ENABLED=false
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=focuslink-ai-reports
# Use Amazon Comprehend for sentiment instead of local VADER
USE_COMPREHEND=false
